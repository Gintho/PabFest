# ─── HelloAsso (obligatoire) ────────────────────────────────────────────────
# Identifiants API : back-office HelloAsso > Mon compte > Intégrations et API.
# En sandbox, créez un compte sur https://www.helloasso-sandbox.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Slug de l'association (dans l'URL HelloAsso : /associations/<slug>)
HELLOASSO_ORG_SLUG=
# sandbox => api.helloasso-sandbox.com | production => api.helloasso.com
HELLOASSO_ENV=sandbox

# URL publique du site, sans slash final. Sert à construire returnUrl/backUrl/errorUrl.
# HTTPS obligatoire en production (http://localhost toléré en sandbox).
SITE_URL=http://localhost:3000

# ─── Notifications (webhook) ────────────────────────────────────────────────
# Jeton secret (>= 32 caractères aléatoires) à placer dans l'URL de notification
# déclarée chez HelloAsso : <SITE_URL>/api/webhook?token=<HELLOASSO_WEBHOOK_TOKEN>
# Générer : openssl rand -hex 32
HELLOASSO_WEBHOOK_TOKEN=
# Optionnel : clé de signature (en-tête x-ha-signature, HMAC-SHA256 du corps).
# Documentée par HelloAsso pour les comptes partenaires. Si vide, non vérifiée.
HELLOASSO_WEBHOOK_SIGNATURE_KEY=

# ─── Don ────────────────────────────────────────────────────────────────────
# Montant maximum accepté (en euros, entier). Minimum fixe : 1 €.
DONATION_MAX_EUR=50000

# ─── Anti-bot (optionnel) ───────────────────────────────────────────────────
# Le honeypot est toujours actif. Renseigner les deux clés active Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
